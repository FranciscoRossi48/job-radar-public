# Copy this file to .env and fill in the key for the provider selected in config/llm.yaml.
# AgentRouter (default): used by both the Codex CLI and direct HTTP backends.
AGENTROUTER_API_KEY=
# Optional override for the direct HTTP backend; default is https://agentrouter.org/v1.
AGENTROUTER_BASE_URL=
# Only needed when config/llm.yaml uses provider: gemini.
GEMINI_API_KEY=
# ntfy topic for phone notifications (see config/app.yaml: ntfy). Make it long and random.
NTFY_TOPIC=
